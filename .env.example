# P1 local unprotected demo; explicitly load this file with uvicorn --env-file .env.
# Never use a VITE_ prefix for secrets: those values reach browser bundles.
AGENTGUARD_LLM_PROVIDER=fake
AGENTGUARD_ENABLE_REAL_API=false
AGENTGUARD_ENABLE_BENCHMARKS=false
AGENTGUARD_ENABLE_BASELINE=false
DEEPSEEK_API_KEY=
AGENTGUARD_SANDBOX_ROOT=.cache/demo
AGENTGUARD_MAX_PROVIDER_CALLS=8
AGENTGUARD_MAX_TOTAL_PROVIDER_CALLS=16
AGENTGUARD_MAX_TOKENS=256

